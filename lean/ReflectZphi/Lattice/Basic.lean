import ReflectZphi.Ring.Embed

/-!
# Rank-3 lattices over a real quadratic order: the basic notions

The order is `O = QuadraticAlgebra ℤ a b` (`ω² = a + bω`), with its two real embeddings
`ι₁ = emb a b 1` and `ι₂ = emb a b (-1)` (`ω ↦ (b ± √(b² + 4a))/2`). A lattice is `O³`
with a symmetric Gram matrix `G`. These are the notions in which the main theorems and
the imported results are stated:

* `Admissible G`: `G` symmetric, of signature `(2,1)` at `ι₁` and positive definite at `ι₂`.
* `IsRoot G r`: `r` primitive, `r·r` totally positive, `r·r ∣ 2 (r·x)` for all `x`.
* `IsReflectionOf G r g`: `g` is the reflection in `r`, stated without division:
  `(r·r) g(x) = (r·r) x - 2 (r·x) r`.
* `isometryGroup G` (= `O(L)`), `reflectionGroup G` (= `W(L)`), and `Reflective G`:
  `W(L)` has finite index in `O(L)`.
-/

namespace ReflectZphi.Lattice

open Matrix QuadraticAlgebra

variable {a b : ℤ}

/-- The ring of the lattice. -/
abbrev O (a b : ℤ) := QuadraticAlgebra ℤ a b

/-- The bilinear form of `G`. -/
def bil (G : Matrix (Fin 3) (Fin 3) (O a b)) (x y : Fin 3 → O a b) : O a b :=
  x ⬝ᵥ (G *ᵥ y)

/-- `ι₁`, the embedding at which the form is hyperbolic. -/
noncomputable def ι₁ (hd : 0 ≤ (b : ℝ) ^ 2 + 4 * a) : O a b →+* ℝ :=
  ReflectZphi.emb a b 1 hd (by norm_num)

/-- `ι₂ = σ ∘ ι₁`, the embedding at which the form is definite. -/
noncomputable def ι₂ (hd : 0 ≤ (b : ℝ) ^ 2 + 4 * a) : O a b →+* ℝ :=
  ReflectZphi.emb a b (-1) hd (by norm_num)

/-- Totally positive: positive at both embeddings. -/
def TotPos (hd : 0 ≤ (b : ℝ) ^ 2 + 4 * a) (z : O a b) : Prop :=
  0 < ι₁ hd z ∧ 0 < ι₂ hd z

/-- Admissible Gram matrix: symmetric; at `ι₁` of signature `(2,1)` (negative determinant
and some vector of positive norm; a real symmetric `3×3` matrix with negative determinant
has signature `(2,1)` or `(0,3)`); at `ι₂` positive definite. -/
structure Admissible (hd : 0 ≤ (b : ℝ) ^ 2 + 4 * a) (G : Matrix (Fin 3) (Fin 3) (O a b)) :
    Prop where
  symm : Gᵀ = G
  det_neg : (G.map (ι₁ hd)).det < 0
  exists_pos : ∃ v : Fin 3 → ℝ, 0 < v ⬝ᵥ (G.map (ι₁ hd) *ᵥ v)
  posDef₂ : (G.map (ι₂ hd)).PosDef

/-- Primitive vector: the only common divisors of its coordinates are units. -/
def Primitive (r : Fin 3 → O a b) : Prop :=
  ∀ c : O a b, (∀ i, c ∣ r i) → IsUnit c

/-- A root of `(O³, G)`. -/
structure IsRoot (hd : 0 ≤ (b : ℝ) ^ 2 + 4 * a) (G : Matrix (Fin 3) (Fin 3) (O a b))
    (r : Fin 3 → O a b) : Prop where
  primitive : Primitive r
  totPos : TotPos hd (bil G r r)
  dvd : ∀ x : Fin 3 → O a b, bil G r r ∣ 2 * bil G r x

/-- `g` is the reflection in `r`: `(r·r) g(x) = (r·r) x - 2 (r·x) r` (no division). -/
def IsReflectionOf (G : Matrix (Fin 3) (Fin 3) (O a b)) (r : Fin 3 → O a b)
    (g : Matrix (Fin 3) (Fin 3) (O a b)) : Prop :=
  ∀ x : Fin 3 → O a b, bil G r r • (g *ᵥ x) = bil G r r • x - (2 * bil G r x) • r

/-- `O(L)`: the integral isometries, `gᵀ G g = G` with `g ∈ GL₃(O)`. -/
def isometryGroup (G : Matrix (Fin 3) (Fin 3) (O a b)) : Subgroup (GL (Fin 3) (O a b)) where
  carrier := {g | (g.val)ᵀ * G * g.val = G}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh
    change (g.val)ᵀ * G * g.val = G at hg
    change (h.val)ᵀ * G * h.val = G at hh
    change ((g * h).val)ᵀ * G * (g * h).val = G
    rw [Units.val_mul, transpose_mul]
    calc (h.val)ᵀ * (g.val)ᵀ * G * (g.val * h.val)
        = (h.val)ᵀ * ((g.val)ᵀ * G * g.val) * h.val := by simp only [Matrix.mul_assoc]
      _ = G := by rw [hg, hh]
  inv_mem' := by
    intro g hg
    change (g.val)ᵀ * G * g.val = G at hg
    change ((g⁻¹).val)ᵀ * G * (g⁻¹).val = G
    have hu : g.val * (g⁻¹).val = 1 := by
      rw [← Units.val_mul, mul_inv_cancel, Units.val_one]
    have hu' : ((g⁻¹).val)ᵀ * (g.val)ᵀ = 1 := by
      rw [← transpose_mul, hu, transpose_one]
    calc ((g⁻¹).val)ᵀ * G * (g⁻¹).val
        = ((g⁻¹).val)ᵀ * ((g.val)ᵀ * G * g.val) * (g⁻¹).val := by rw [hg]
      _ = (((g⁻¹).val)ᵀ * (g.val)ᵀ) * G * (g.val * (g⁻¹).val) := by
          simp only [Matrix.mul_assoc]
      _ = G := by rw [hu, hu']; simp

/-- `W(L)`: generated by the reflections in the roots. -/
def reflectionGroup (hd : 0 ≤ (b : ℝ) ^ 2 + 4 * a) (G : Matrix (Fin 3) (Fin 3) (O a b)) :
    Subgroup (GL (Fin 3) (O a b)) :=
  Subgroup.closure {g | ∃ r, IsRoot hd G r ∧ IsReflectionOf G r g.val}

/-- `L` is reflective: `W(L)` has finite index in `O(L)`. -/
def Reflective (hd : 0 ≤ (b : ℝ) ^ 2 + 4 * a) (G : Matrix (Fin 3) (Fin 3) (O a b)) : Prop :=
  ((reflectionGroup hd G).subgroupOf (isometryGroup G)).FiniteIndex

end ReflectZphi.Lattice
